# 数据库路径
DB_PATH=./data/auto-rss.db

# qBittorrent 配置
QB_HOST=http://localhost:8080
QB_USERNAME=admin
QB_PASSWORD=

# RSS 检查间隔
RSS_INTERVAL=30m

# 日志级别 (debug/info/warn/error)
LOG_LEVEL=info

# 服务器端口
SERVER_PORT=7892

# 下载路径
DOWNLOAD_PATH=/downloads

# 限流配置 (Rate Limiting)
# 通用API限流: 每秒请求数 (默认: 10)
RATE_LIMIT_RPS=10

# 通用API限流: 突发请求数 (默认: 20)
RATE_LIMIT_BURST=20

# 认证端点限流: 每分钟请求数 (默认: 5, 用于 /api/v1/auth/login 和 /api/v1/auth/refresh)
RATE_LIMIT_AUTH_RPM=5

# 最大缓存客户端数 (默认: 10000, 超出时LRU淘汰)
RATE_LIMIT_MAX_ENTRIES=10000

# 不活跃客户端数据清理时间 (默认: 1h)
RATE_LIMIT_TTL=1h
