# 数据库路径
DB_PATH=./data/auto-rss.db

# qBittorrent 配置
QB_HOST=http://localhost:8080
QB_USERNAME=admin
QB_PASSWORD=

# RSS 检查间隔
RSS_INTERVAL=30m

# 日志级别 (debug/info/warn/error)
LOG_LEVEL=info

# 服务器端口
SERVER_PORT=7892

# 下载路径
DOWNLOAD_PATH=/downloads

# 访问保护（默认关闭，兼容本地/NAS 既有部署）
# 设置为 true 后，除健康检查、静态资源、封面和 /api/v1/auth/* 外，API 均需要 Bearer token。
AUTH_ENABLED=false

# 认证启用时必须修改以下默认值；JWT_SECRET 至少 32 字符，JWT_PASSWORD 不能使用 admin。
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_USERNAME=admin
JWT_PASSWORD=change-this-password
JWT_ACCESS_TOKEN_EXPIRY=30m
JWT_REFRESH_TOKEN_EXPIRY=168h

# 限流配置 (Rate Limiting)
# 通用API限流: 每秒请求数 (默认: 10)
RATE_LIMIT_RPS=10

# 通用API限流: 突发请求数 (默认: 20)
RATE_LIMIT_BURST=20

# 认证端点限流: 每分钟请求数 (默认: 5, 用于 /api/v1/auth/login 和 /api/v1/auth/refresh)
RATE_LIMIT_AUTH_RPM=5

# 最大缓存客户端数 (默认: 10000, 超出时LRU淘汰)
RATE_LIMIT_MAX_ENTRIES=10000

# 不活跃客户端数据清理时间 (默认: 1h)
RATE_LIMIT_TTL=1h
